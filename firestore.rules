rules_version = '2';

// Deployed with `firebase deploy --only firestore:rules` (config in
// firebase.json / .firebaserc). Keep this file as the source of truth —
// do not hand-edit rules in the Firebase console.
//
// Model: every signed-in user has a matching users/{uid} doc with a
// `role` field ("admin" | "editor" | "viewer").
//
//   properties  — world-readable (the public marketing site can read the
//                 catalog directly); create/update/delete restricted to
//                 admin or editor, with light shape validation.
//   users       — a user may read their own profile; only admins may list
//                 the directory or create/update/delete profiles.
//   leads       — created by anonymous visitors via the "Agente" widget
//                 (shape-validated, server timestamp, status forced to
//                 "nuevo"); only admin/editor can read or advance them.
//
// "Zonas" on the public site are static config (lib/properties.ts:ZONES),
// not a Firestore collection, so they need no rules here.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- role helpers -------------------------------------------------
    function signedIn() {
      return request.auth != null;
    }

    function roleOf(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        ? get(/databases/$(database)/documents/users/$(uid)).data.role
        : null;
    }

    function myRole() {
      return signedIn() ? roleOf(request.auth.uid) : null;
    }

    function isAdmin() {
      return myRole() == 'admin';
    }

    function isEditorOrAdmin() {
      return myRole() == 'admin' || myRole() == 'editor';
    }

    // ---- properties -------------------------------------------------
    function isValidProperty(data) {
      return data.title is string
        && data.description is string
        && data.price is number
        && data.zone is string
        && data.type is string
        && data.sqm is number
        && data.beds is number
        && data.images is list
        && data.status in ['Publicada', 'Borrador'];
    }

    match /properties/{propertyId} {
      allow read: if true;
      allow create, update: if isEditorOrAdmin()
        && isValidProperty(request.resource.data);
      allow delete: if isEditorOrAdmin();
    }

    // ---- users ------------------------------------------------------
    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create, update, delete: if isAdmin();
    }

    // ---- leads (public "Agente" widget) ---------------------------
    function isValidLead(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 120
        && data.email is string && data.email.matches('.+@.+[.].+')
        && data.score is number && data.score >= 1 && data.score <= 10
        && data.status == 'nuevo'
        && data.createdAt == request.time
        && data.zones is list
        && data.obstacles is list;
    }

    match /leads/{leadId} {
      allow create: if isValidLead(request.resource.data);
      allow read, update: if isEditorOrAdmin();
      allow delete: if isAdmin();
    }

    // ---- everything else: explicit deny ---------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
