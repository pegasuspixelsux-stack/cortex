rules_version = '2';

// Deployed with `firebase deploy --only storage` (config in firebase.json).
//
//   properties/**, agents/**, brand/** — world-readable (image URLs render
//     on the public site and in reels). Writes: any signed-in user, images
//     only, under 5 MB. Role enforcement lives in firestore.rules — the
//     property/agent doc that references the image can only be written by
//     an admin or editor, so an orphan upload is the worst case here.
//     (Storage rules can't reliably read Firestore cross-service.)
//   everything else — denied.

service firebase.storage {
  match /b/{bucket}/o {

    function isImageUnder5mb() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /properties/{path=**} {
      allow read: if true;
      allow create, update: if request.auth != null && isImageUnder5mb();
      allow delete: if request.auth != null;
    }

    match /agents/{path=**} {
      allow read: if true;
      allow create, update: if request.auth != null && isImageUnder5mb();
      allow delete: if request.auth != null;
    }

    match /brand/{path=**} {
      allow read: if true;
      allow create, update: if request.auth != null && isImageUnder5mb();
      allow delete: if request.auth != null;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
